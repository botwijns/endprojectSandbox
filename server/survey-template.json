{
  "version": "2026-10-15",
  "title": "Vragenlijst",
  "intro": "Bedankt voor het spelen! Een paar vragen na afloop, dit duurt ongeveer een minuut.",
  "submitLabel": "Versturen",
  "thankYou": "Bedankt, je antwoorden zijn opgeslagen.",
  "questions": [
    {
      "id": "gaming_frequency",
      "type": "single",
      "label": "Hoe vaak speel je games?",
      "required": true,
      "options": ["(Bijna) nooit", "Een paar keer per maand", "Wekelijks", "Dagelijks"]
    },
    {
      "id": "age",
      "type": "scale",
      "label": "Hoe oud ben je?",
      "required": true,
      "min": 8,
      "max": 13,
      "minOptionLabel": "8 of jonger",
      "maxOptionLabel": "13 of ouder"
    },
    {
      "id": "favorite_prototype",
      "type": "single",
      "label": "Welk deel van het spel vond je het leukst?",
      "required": false,
      "options": [
        "Vissen met victor",
        "Muziek maken met Mike",
        "De Quiz met Quinten"
      ]
    },
    {
      "id": "length",
      "type": "slider",
      "label": "Hoeveel minuten denk je dat je gespeeld hebt?",
      "required": true,
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "minuten"
    },
    {
      "id": "gorrilla_noticed",
      "type": "boolean",
      "label": "Heb je een geluid gehoord dat niet op zn plek hoorde?",
      "required": true

    },
    {
      "id": "gorrilla_which",
      "type": "single",
      "label": "Welke van deze geluiden heb je gehoord?",
      "required": true,
      "showIf": { "question": "gorrilla_noticed", "equals": true },
      "options": [
        "Een kat die miauwt",
        "Een hond die blaft",
        "Een boing van een veer",
        "Ik heb een ander geluid gehoord"
      ]
    },
    {
      "id": "gorrilla_when",
      "type": "multi",
      "label": "Tijdens wel spel heb je dit geluid gehoord?",
      "required": true,
      "showIf": { "question": "gorrilla_noticed", "equals": true },
      "options": [
        "Vissen met victor",
        "Muziek maken met Mike",
        "De Quiz met Quinten"
      ]
    },
    {
      "id": "rating",
      "type": "scale",
      "label": "Welk cijfer zou je het spel geven?",
      "required": true,
      "min": 1,
      "max": 10,
      "minLabel": "Niet leuk",
      "maxLabel": "Heel leuk"
    },
    {
      "id": "would_recommend",
      "type": "boolean",
      "label": "Zou je dit willen spelen bij de tandarts?",
      "required": true
    },
    {
      "id": "comments",
      "type": "text",
      "label": "Als je een ding zou willen veranderen aan het spel, wat zou dat dan zijn?",
      "required": false,
      "maxLength": 2000,
      "placeholder": "Wat viel je op? Wat kon beter?"
    }
  ]
}
