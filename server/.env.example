# Copy to .env and adjust. All values are optional; defaults shown.

# TCP port the API listens on.
PORT=3000

# Where the SQLite file lives. Relative paths resolve from the server/ folder.
DB_PATH=./data/game.db

# Comma-separated list of browser origins allowed to call the API.
# Use "*" to allow any origin (fine for a local / anonymous research setup).
# Example for GitHub Pages: https://botwijns.github.io
ALLOWED_ORIGINS=*

# If set, GET /api/export requires  Authorization: Bearer <this value>.
# Leave empty to disable the export endpoint entirely.
EXPORT_TOKEN=

# Max write requests per IP per minute (progress + survey). IPs are used only
# in memory for this check and are never written to disk or logged.
RATE_LIMIT_PER_MIN=120
